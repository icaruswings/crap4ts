{
  "name": "@icaruswings138/crap4ts",
  "version": "0.1.0",
  "description": "CRAP scores for TypeScript and TSX using cyclomatic complexity and test coverage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icaruswings/crap4ts.git"
  },
  "homepage": "https://github.com/icaruswings/crap4ts#readme",
  "bugs": "https://github.com/icaruswings/crap4ts/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "src",
    "SKILL.md",
    "CONTRIBUTING.md"
  ],
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.19"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.18.0 || >=24.11.0",
      "onFail": "warn"
    }
  },
  "bin": {
    "crap4ts": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "self-check": "pnpm build && node dist/cli/main.js",
    "verify": "pnpm test && pnpm self-check",
    "verify:full": "pnpm verify && pnpm mutation",
    "mutation": "stryker run"
  },
  "dependencies": {
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "vitest": "4.1.11"
  }
}
